# Explicit mcp settings. Copy to mcp_settings.env and set deployment values.
# Every key is required; use null only where the corresponding type permits None.
SERVICE_MCP_TRANSPORT_HOST='0.0.0.0'
SERVICE_MCP_AUTH_MODE='none'
SERVICE_MCP_OAUTH_ISSUER='null'
SERVICE_MCP_OAUTH_AUDIENCE='null'
SERVICE_MCP_OAUTH_JWKS_URL='null'
SERVICE_MCP_OAUTH_RESOURCE='null'
SERVICE_MCP_OAUTH_AUTHORIZATION_SERVERS='null'
SERVICE_MCP_OAUTH_REQUIRED_SCOPE='alexandria:mcp'
SERVICE_MCP_LOCAL_APPROVAL_KEY='null'
SERVICE_MCP_LOCAL_ACCESS_TOKEN_TTL_SECONDS='3600'
SERVICE_MCP_LOCAL_REFRESH_TOKEN_TTL_SECONDS='2592000'
SERVICE_MCP_LOCAL_AUTHORIZATION_CODE_TTL_SECONDS='300'
SERVICE_MCP_LOCAL_APPROVAL_TTL_SECONDS='600'
SERVICE_MCP_LOCAL_PAIRING_CODE_TTL_SECONDS='300'
SERVICE_MCP_LOCAL_MAX_APPROVAL_ATTEMPTS='5'
