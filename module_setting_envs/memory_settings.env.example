# Explicit memory settings. Copy to memory_settings.env and set deployment values.
# Every key is required; use null only where the corresponding type permits None.
SERVICE_RAG_VECTOR_ENABLED='true'
SERVICE_RAG_EMBEDDING_PROVIDER='fastembed'
SERVICE_RAG_EMBEDDING_MODEL='intfloat/multilingual-e5-small'
SERVICE_RAG_EMBEDDING_DIMENSIONS='384'
SERVICE_RAG_EMBEDDING_CACHE_DIR='null'
SERVICE_RAG_EMBEDDING_THREADS='4'
SERVICE_RAG_EMBEDDING_RECOVERY_ON_STARTUP='false'
SERVICE_RAG_EMBEDDING_RECOVERY_ON_VAULT_REINDEX='false'
SERVICE_RAG_EMBEDDING_RECOVERY_BATCH_SIZE='250'
SERVICE_RAG_EMBEDDING_RECOVERY_MAX_BATCHES='40'
SERVICE_RAG_EMBEDDING_TOKEN_PATH='/run/secrets/huggingface-token'
HF_HOME='null'
FASTEMBED_CACHE_DIR='.fastembed_cache'
HF_ENDPOINT='https://huggingface.co'
ORT_LOAD_CONFIG_FROM_MODEL='0'
