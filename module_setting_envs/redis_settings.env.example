# Explicit redis settings. Copy to redis_settings.env and set deployment values.
# Every key is required; use null only where the corresponding type permits None.
SERVICE_REDIS_URL='null'
SERVICE_REDIS_MAX_CONNECTIONS='8'
SERVICE_REDIS_OPERATIONAL_READINESS_TTL_SECONDS='5'
SERVICE_REDIS_GRAPH_STATUS_TTL_SECONDS='5'
SERVICE_REDIS_EMBEDDING_HEALTH_TTL_SECONDS='10'
SERVICE_REDIS_EXTERNAL_API_RATE_LIMIT='60'
SERVICE_REDIS_EXTERNAL_API_RATE_WINDOW_SECONDS='60'
SERVICE_REDIS_MAINTENANCE_QUEUE_ENABLED='true'
SERVICE_REDIS_MAINTENANCE_STREAM_NAME='alexandria:maintenance:v1'
SERVICE_REDIS_MAINTENANCE_DEAD_LETTER_STREAM_NAME='alexandria:maintenance:dead:v1'
SERVICE_REDIS_MAINTENANCE_CONSUMER_GROUP='alexandria-maintenance-workers-v1'
SERVICE_REDIS_MAINTENANCE_STATUS_KEY_PREFIX='alexandria:maintenance:job:v1'
SERVICE_REDIS_MAINTENANCE_DEDUP_KEY_PREFIX='alexandria:maintenance:dedup:v1'
SERVICE_REDIS_MAINTENANCE_RATE_KEY_PREFIX='alexandria:rate:v1'
SERVICE_REDIS_MAINTENANCE_WORKER_CONCURRENCY='1'
SERVICE_REDIS_MAINTENANCE_BATCH_LIMIT='250'
SERVICE_REDIS_MAINTENANCE_MAX_ATTEMPTS='3'
SERVICE_REDIS_MAINTENANCE_RETRY_IDLE_SECONDS='15'
SERVICE_REDIS_MAINTENANCE_BLOCK_MILLISECONDS='2000'
SERVICE_REDIS_MAINTENANCE_STATUS_TTL_SECONDS='86400'
SERVICE_REDIS_MAINTENANCE_DEDUP_COOLDOWN_SECONDS='60'
SERVICE_REDIS_MAINTENANCE_SUBMISSION_LIMIT='6'
SERVICE_REDIS_MAINTENANCE_SUBMISSION_WINDOW_SECONDS='60'
SERVICE_REDIS_MAINTENANCE_MAX_STREAM_LENGTH='10000'
SERVICE_REDIS_MAINTENANCE_WORKER_MAX_CONNECTIONS='2'
SERVICE_RAG_MAINTENANCE_EMBEDDING_THREADS='1'
