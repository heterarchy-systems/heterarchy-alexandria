# Host profile: Apple M1 Pro (10 CPU cores) with 16 GiB assigned to Docker.
# Credentials and endpoints remain in the operator-local file; this file owns deterministic tuning only.

# Local multilingual-e5-small embedding runtime.
SERVICE_RAG_VECTOR_ENABLED=true
SERVICE_RAG_EMBEDDING_PROVIDER=fastembed
SERVICE_RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
SERVICE_RAG_EMBEDDING_DIMENSIONS=384
SERVICE_RAG_EMBEDDING_CACHE_DIR=/app/cache/embeddings
SERVICE_RAG_EMBEDDING_THREADS=4
SERVICE_RAG_MAINTENANCE_EMBEDDING_THREADS=8
SERVICE_RAG_EMBEDDING_RECOVERY_ON_STARTUP=false
SERVICE_RAG_EMBEDDING_RECOVERY_ON_VAULT_REINDEX=false

# Redis API cache and bounded maintenance queue.
# Internal Compose endpoint; deterministic and not a credential.
SERVICE_REDIS_URL=redis://alexandria-redis:6379/0
SERVICE_REDIS_MAX_CONNECTIONS=8
SERVICE_REDIS_OPERATIONAL_READINESS_TTL_SECONDS=5
SERVICE_REDIS_GRAPH_STATUS_TTL_SECONDS=5
SERVICE_REDIS_EMBEDDING_HEALTH_TTL_SECONDS=10
SERVICE_REDIS_MAINTENANCE_WORKER_CONCURRENCY=1
SERVICE_REDIS_MAINTENANCE_BATCH_LIMIT=250
SERVICE_REDIS_MAINTENANCE_MAX_ATTEMPTS=3
SERVICE_REDIS_MAINTENANCE_RETRY_IDLE_SECONDS=120
SERVICE_REDIS_MAINTENANCE_DEDUP_COOLDOWN_SECONDS=300
SERVICE_REDIS_MAINTENANCE_BLOCK_MILLISECONDS=1000
SERVICE_REDIS_MAINTENANCE_STATUS_TTL_SECONDS=86400
SERVICE_REDIS_MAINTENANCE_SUBMISSION_LIMIT=6
SERVICE_REDIS_MAINTENANCE_SUBMISSION_WINDOW_SECONDS=60
SERVICE_REDIS_MAINTENANCE_MAX_STREAM_LENGTH=10000
SERVICE_REDIS_MAINTENANCE_WORKER_MAX_CONNECTIONS=2
ALEXANDRIA_REDIS_MAXMEMORY=256mb
